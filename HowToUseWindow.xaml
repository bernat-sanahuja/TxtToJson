<Window x:Class="TxtToJson.HowToUseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="How to use"
        Icon="/Resources/Icons/icon.ico"
        Width="840" Height="740"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FB"
        FontFamily="Segoe UI">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="How to use"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="Write one key:value per line. Indentation builds the structure."
                       FontSize="13" Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Reglas -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Rules"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="key:value"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="One pair per line. Everything after the first ':' is the value."/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="  indented"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="Indented lines belong to the key above them."/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="key:"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="Nothing after the colon opens a nested object."/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="-item"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="A dash starts a list item. '-name:blue' makes a list of objects."/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="[a, b, c]"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="Short list on a single line."/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&quot;28&quot;   vs   28"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="Quotes force text. 28 is a number, &quot;28&quot; is text."/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="true / false / null"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="Boolean and null, unquoted."/>
                        </Grid>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1.68"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="Decimals, also with comma (1,68). 08001 loses its leading zero unless you quote it."/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="blank line"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#2563EB"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="Ignored. If something is wrong, the error tells you the line number."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Ejemplo -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="example.txt"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="4,0,0,6"/>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="TextoTxt"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource InkBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="example.json"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="4,0,0,6"/>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="TextoJson"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource InkBrush}"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Close"
                Style="{StaticResource GhostButton}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="Cerrar_Click"/>
    </Grid>
</Window>
