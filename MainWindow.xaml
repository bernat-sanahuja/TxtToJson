<Window x:Class="TxtToJson.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TxtToJson"
        Icon="/Resources/Icons/icon.ico"
        Height="660" Width="880"
        MinHeight="640" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave">

    <Window.Resources>
        <!-- Propios de esta ventana: los colores y los botones base están en App.xaml -->
        <SolidColorBrush x:Key="JsonBack"   Color="#EEF2FF"/>
        <SolidColorBrush x:Key="JsonInk"    Color="#2563EB"/>

        <LinearGradientBrush x:Key="DropHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F7FB" Offset="0"/>
            <GradientStop Color="#C7D6FA" Offset="1"/>
        </LinearGradientBrush>

        <!-- "Back": solo se ve en la vista de resultados -->
        <Style x:Key="BackButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MostrandoResultados}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "Download all": solo se ve en la vista de resultados -->
        <Style x:Key="DownloadAllButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MostrandoResultados}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- "Execute": se oculta en la vista de resultados -->
        <Style x:Key="ExecuteButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MostrandoResultados}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="TxtToJson"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="Drag &amp; drop your .txt files below"
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0">
                <Button Content="← Back"
                        Style="{StaticResource BackButton}"
                        Click="Volver_Click"
                        Margin="0,0,8,0"/>
                <Button Content="How to use"
                        Style="{StaticResource GhostButton}"
                        Click="Ayuda_Click"
                        Margin="0,0,8,0"/>
                <Button Content="Download all"
                        Style="{StaticResource DownloadAllButton}"
                        Click="DescargarTodo_Click"
                        Margin="0,0,8,0"/>
                <Button Content="Execute"
                        Style="{StaticResource ExecuteButton}"
                        Click="Execute_Click"/>
            </StackPanel>
        </Grid>

        <!-- Zona principal -->
        <Border Grid.Row="1"
                AllowDrop="True"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <Grid>

                <!-- Vista 1: archivos .txt -->
                <Grid x:Name="PanelArchivos">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MostrandoResultados}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Rectangle RadiusX="8" RadiusY="8"
                               Stroke="{StaticResource LineBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="6 4"
                               IsHitTestVisible="False"/>

                    <!--
                        Superficie del fondo de la zona de archivos: se tiñe al arrastrar.
                        Filas "*" con MinHeight para que no se compriman por debajo de 100.
                    -->
                    <Grid x:Name="Grid1"
                          Background="Transparent"
                          Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="100"/>
                            <RowDefinition Height="*" MinHeight="100"/>
                            <RowDefinition Height="*" MinHeight="100"/>
                            <RowDefinition Height="*" MinHeight="100"/>
                        </Grid.RowDefinitions>
                    </Grid>

                    <ItemsControl x:Name="Lista"
                                  ItemsSource="{Binding Archivos}"
                                  Margin="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="4" Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    MinHeight (no Height): la celda se estira con la
                                    ventana, pero nunca por debajo de 100.
                                    Background Transparent: toda la celda detecta el ratón.
                                -->
                                <Grid MinHeight="100" Background="Transparent">

                                    <!-- Fondo de la celda al pasar el ratón -->
                                    <Border Margin="2" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True"
                                                                 Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                                                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                                Margin="8,4">
                                        <Image Source="/Resources/Icons/txt_icon.png"
                                               Width="48" Height="48"
                                               HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Nombre}"
                                                   ToolTip="{Binding Ruta}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource InkBrush}"/>
                                    </StackPanel>

                                    <!-- Cruz para quitar el archivo (solo visible al pasar el ratón) -->
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="22" Height="22"
                                            Margin="0,2,2,0"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            ToolTip="Remove"
                                            Click="EliminarArchivo_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True"
                                                                 Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Image Source="/Resources/Icons/RedCross.png"
                                               Width="12" Height="12"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Vista 2: resultados .json (clic para guardar) -->
                <Grid x:Name="PanelResultados">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MostrandoResultados}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ItemsControl ItemsSource="{Binding Resultados}" Margin="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="4" Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="100" Background="Transparent">

                                    <!-- Toda la tarjeta es un botón: al pulsarla se guarda el JSON -->
                                    <Button Click="GuardarJson_Click"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            ToolTip="Click to save this JSON">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Fondo"
                                                        Margin="2"
                                                        CornerRadius="8"
                                                        Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Fondo" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Fondo" Property="Background" Value="{StaticResource LineBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>

                                        <StackPanel Margin="8,4" HorizontalAlignment="Stretch">
                                            <Border Width="48" Height="48"
                                                    CornerRadius="10"
                                                    Background="{StaticResource JsonBack}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{}{ }"
                                                           FontFamily="Consolas"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource JsonInk}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="{Binding Nombre}"
                                                       FontSize="12"
                                                       Margin="0,6,0,0"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource InkBrush}"/>

                                            <TextBlock Text="click to save"
                                                       FontSize="10"
                                                       Margin="0,2,0,0"
                                                       TextAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>

        <!-- Pie: cambia según la vista -->
        <Grid Grid.Row="2" Margin="3,14,0,0">
            <TextBlock FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Up to 24 files · .txt only">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoResultados}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Click a .json to save it individually, or use Download all">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrandoResultados}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
